      "manageExistingIndexes": true,
      "automaticBackups": false
    }
  },
  "support": {
    "admissionOpen": false,
    "maintenanceEnabled": false,
    "contactEmail": "YOUR_CONTACT_EMAIL",
    "gmail": {
