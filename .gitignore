# Private configuration and credentials
private/
/config/*
!/config/example/
!/config/common/
.env*
!/.env.example
.secret*
secrets/
env-*.txt
gcp-*.json
*service-account*.json
*adminsdk*.json
client_secret*.json
*.pem
*.key
*.p12
*.pfx

# Operational Web research documents; only assets-public/ is published.
/apps/web/assets/

# Editable research documents
*.docx
*.doc
*.odt

# Dependencies and package-manager caches at any workspace depth
node_modules/
.pnpm-store/
.pnp
.pnp.*
**/.yarn/*
!**/.yarn/patches/
!**/.yarn/plugins/
!**/.yarn/releases/
!**/.yarn/versions/

# Build and framework outputs
.deploy/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
__pycache__/

# Generated outputs at every depth; root output includes private operational state.
# Never publish or hand-edit them; preserve retained state before cleanup.
generated/

# Private Web installer ZIPs and checksums.
distribution/

# Test and browser artifacts
coverage/
.playwright/
test-results/
playwright-report/
**/playwright/.cache/

# Local tools and platform caches
.codex/
.agents/
.firebase/
.vercel/
.DS_Store

# Logs and distribution archives
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tar
*.tar.gz

# Terraform state, plans and generated backend inputs are private
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
