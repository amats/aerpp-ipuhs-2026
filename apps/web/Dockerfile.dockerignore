# Workspace-root context allowlist for the Web image and its shared inputs.
# Keep parent directories excluded; allow only the files or complete trees below.
**
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!docs/licenses/**
!scripts/licenses/collect-license-notices.mjs
!scripts/licenses/stage-license-notices.mjs
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches/*.patch
!apps/web/package.json
!apps/web/tsconfig.json
!apps/web/next-env.d.ts
!apps/web/types.d.ts
!apps/web/next.config.ts
!apps/web/postcss.config.mjs
!apps/web/mdx-components.tsx
!apps/web/src/**
!apps/web/public/**
!apps/web/scripts/image-inputs.mjs
!apps/web/scripts/build-image-app.mjs
!packages/contracts/package.json
!packages/contracts/src/participant-api.ts
!packages/contracts/src/identifiers.ts
!packages/documents/package.json
!packages/documents/src/**
!packages/documents/fonts/*.ttf
!packages/config/package.json
!packages/config/src/**
!config/common/documents/version.json
!config/common/llm/*.json
!config/common/survey/*.json

# Research assets are supplied through the selected named build context.
apps/web/assets
apps/web/assets-public

# Shared exclusions: keep identical across application Docker contexts.
**/node_modules
**/.next
**/dist
**/build
**/out
**/generated
