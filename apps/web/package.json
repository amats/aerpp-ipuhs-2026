{
  "name": "@aerpp/web",
  "version": "1.0.0",
  "description": "AI-assisted Ethical Review Pre-Processing support system",
  "author": "Akira Matsushita",
  "license": "MIT",
  "copyright": "2026 Akira Matsushita",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "node ../../scripts/licenses/stage-license-notices.mjs web && next dev",
    "build": "node ../../scripts/licenses/stage-license-notices.mjs web && next build",
    "start": "pnpm run env:check && next start",
    "lint": "biome check && node ../../scripts/checks/check-boundaries.mjs apps/web",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node ../../scripts/licenses/stage-license-notices.mjs web && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --config playwright.debug.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report",
    "test:pdf": "node ./scripts/test-pdf.mjs",
    "test:watch": "node ../../scripts/licenses/stage-license-notices.mjs web && vitest",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test",
    "env:check": "node ./scripts/validate-env.mjs",
    "screenshots": "node ./scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@aerpp/config": "workspace:*",
    "@aerpp/documents": "workspace:*",
    "@aerpp/participant-api-contracts": "workspace:*",
    "@libpdf/core": "catalog:",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "catalog:",
    "@zip.js/zip.js": "2.23.0",
    "dompurify": "^3.4.17",
    "file-saver": "^2.0.5",
    "html-docx-js-typescript": "^0.1.5",
    "iron-session": "catalog:",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "catalog:",
    "pino": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "saxes": "6.0.0",
    "undici": "8.12.1",
    "unified": "^11.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "@types/file-saver": "^2.0.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv": "^18.0.8",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.1.2",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
