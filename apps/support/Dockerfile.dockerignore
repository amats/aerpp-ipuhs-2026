# Workspace-root context allowlist for the Support image and its shared inputs.
# Keep parent directories excluded; allow only the files or complete trees below.
**
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!docs/licenses/**
!scripts/licenses/collect-license-notices.mjs
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches/*.patch
!apps/support/package.json
!apps/support/src/**
!apps/support/scripts/build.mjs
!apps/support/README.md
!packages/firestore/package.json
!packages/firestore/src/**
!packages/config/package.json
!packages/config/src/**
!packages/contracts/package.json
!packages/contracts/src/participant-api.ts

# Shared exclusions: keep identical across application Docker contexts.
**/node_modules
**/.next
**/dist
**/build
**/out
**/generated
**/private
**/secrets
**/.git
**/.env*
**/.secret*
**/env-*.txt
**/gcp-*.json
**/*service-account*.json
**/*adminsdk*.json
**/client_secret*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/logs
**/*.tar
**/*.tar.gz
**/.playwright
**/playwright-report
**/test-results
**/coverage
**/*.test.*
**/tests
**/test-support
**/e2e
**/playwright*.config.*
**/*.tsbuildinfo
**/__pycache__
**/.firebase
**/.terraform
**/*.tfstate*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
**/.DS_Store
**/.agents
**/.codex
**/*.docx
**/*.doc
**/*.odt
