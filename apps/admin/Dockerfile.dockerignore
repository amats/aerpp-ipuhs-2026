# Workspace-root context allowlist for the Admin image and its shared inputs.
# Keep parent directories excluded; allow only the files or complete trees below.
**
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!docs/licenses/**
!scripts/licenses/collect-license-notices.mjs
!scripts/licenses/stage-license-notices.mjs
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches/*.patch
!apps/admin/package.json
!apps/admin/tsconfig.json
!apps/admin/next-env.d.ts
!apps/admin/next.config.ts
!apps/admin/postcss.config.mjs
!apps/admin/src/**
!apps/admin/public/**
!apps/admin/scripts/build-image-app.mjs
!apps/admin/scripts/build-settings.mjs
!apps/admin/scripts/build-environment.mjs
!apps/admin/scripts/start-image.mjs
!packages/firestore/package.json
!packages/firestore/src/**
!packages/contracts/package.json
!packages/contracts/src/participant-api.ts
!packages/contracts/src/identifiers.ts
!packages/documents/package.json
!packages/documents/src/**
!packages/documents/fonts/*.ttf
!packages/config/package.json
!packages/config/src/**

# Shared exclusions: keep identical across application Docker contexts.
**/node_modules
**/.next
**/dist
**/build
**/out
**/generated
**/private
**/secrets
**/.git
**/.env*
**/.secret*
**/env-*.txt
**/gcp-*.json
**/*service-account*.json
**/*adminsdk*.json
**/client_secret*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/logs
**/*.tar
**/*.tar.gz
**/.playwright
**/playwright-report
**/test-results
**/coverage
**/*.test.*
**/tests
**/test-support
**/e2e
**/playwright*.config.*
**/*.tsbuildinfo
**/__pycache__
**/.firebase
**/.terraform
**/*.tfstate*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
**/.DS_Store
**/.agents
**/.codex
**/*.docx
**/*.doc
**/*.odt
