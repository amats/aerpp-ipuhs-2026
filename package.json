{
  "name": "aerpp-ipuhs-2026",
  "version": "1.0.0",
  "description": "Workspace for AI-assisted Ethical Review Pre-Processing system",
  "author": "Akira Matsushita",
  "license": "MIT",
  "copyright": "2026 Akira Matsushita",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "dev:admin": "pnpm run env:run test admin dev",
    "dev:web": "pnpm run env:run test web dev",
    "build": "pnpm run build:config && pnpm run build:web && pnpm run build:admin && pnpm run build:support && node scripts/licenses/check-license-traces.mjs",
    "build:admin": "pnpm --fail-if-no-match --filter @aerpp/admin run build:local",
    "build:config": "pnpm --fail-if-no-match --filter @aerpp/config run build",
    "build:support": "pnpm --fail-if-no-match --filter @aerpp/support run build",
    "build:web": "pnpm run env:run example web build",
    "lint": "pnpm run lint:web && pnpm run lint:admin && pnpm run lint:support && pnpm run lint:config && pnpm run lint:contracts && pnpm run lint:firestore && pnpm run lint:documents && pnpm run lint:tooling",
    "lint:admin": "pnpm --fail-if-no-match --filter @aerpp/admin run lint",
    "lint:config": "pnpm --fail-if-no-match --filter @aerpp/config run lint",
    "lint:contracts": "pnpm --fail-if-no-match --filter @aerpp/participant-api-contracts run lint",
    "lint:documents": "pnpm --fail-if-no-match --filter @aerpp/documents run lint",
    "lint:firestore": "pnpm --fail-if-no-match --filter @aerpp/firestore run lint",
    "lint:support": "pnpm --fail-if-no-match --filter @aerpp/support run lint",
    "lint:tooling": "biome check scripts biome.json package.json",
    "lint:web": "pnpm --fail-if-no-match --filter @aerpp/web run lint",
    "format": "pnpm run format:web && pnpm run format:admin && pnpm run format:support && pnpm run format:config && pnpm run format:contracts && pnpm run format:documents && pnpm run format:firestore && pnpm run format:tooling",
    "format:admin": "pnpm --fail-if-no-match --filter @aerpp/admin run format",
    "format:config": "pnpm --fail-if-no-match --filter @aerpp/config run format",
    "format:contracts": "pnpm --fail-if-no-match --filter @aerpp/participant-api-contracts run format",
    "format:documents": "pnpm --fail-if-no-match --filter @aerpp/documents run format",
    "format:firestore": "pnpm --fail-if-no-match --filter @aerpp/firestore run format",
    "format:support": "pnpm --fail-if-no-match --filter @aerpp/support run format",
    "format:tooling": "biome format --write scripts biome.json package.json",
    "format:web": "pnpm --fail-if-no-match --filter @aerpp/web run format",
    "typecheck": "pnpm run typecheck:config && pnpm run typecheck:documents && pnpm run typecheck:firestore && pnpm run typecheck:web && pnpm run typecheck:admin && pnpm run typecheck:support",
    "typecheck:admin": "pnpm --fail-if-no-match --filter @aerpp/admin run typecheck",
    "typecheck:config": "pnpm --fail-if-no-match --filter @aerpp/config run typecheck",
    "typecheck:documents": "pnpm --fail-if-no-match --filter @aerpp/documents run typecheck",
    "typecheck:firestore": "pnpm --fail-if-no-match --filter @aerpp/firestore run typecheck",
    "typecheck:support": "pnpm --fail-if-no-match --filter @aerpp/support run typecheck",
    "typecheck:web": "pnpm --fail-if-no-match --filter @aerpp/web run typecheck",
    "test": "pnpm run test:config && pnpm run test:firestore && pnpm run test:tooling && pnpm run test:web && pnpm run test:admin && pnpm run test:support",
    "test:admin": "pnpm --fail-if-no-match --filter @aerpp/admin run test",
    "test:config": "pnpm --fail-if-no-match --filter @aerpp/config run test",
    "test:e2e:admin": "pnpm --filter @aerpp/admin run test:e2e",
    "test:e2e:install": "pnpm --fail-if-no-match --filter @aerpp/web exec playwright install chromium",
    "test:e2e:web": "pnpm --fail-if-no-match --filter @aerpp/web run test:e2e",
    "test:emulator": "pnpm --filter @aerpp/support run test:emulator",
    "test:firestore": "pnpm --fail-if-no-match --filter @aerpp/firestore run test",
    "test:support": "pnpm --fail-if-no-match --filter @aerpp/support run test",
    "test:tooling": "node --test \"scripts/**/*.test.mjs\"",
    "test:watch:web": "pnpm --fail-if-no-match --filter @aerpp/web run test:watch",
    "test:web": "pnpm --fail-if-no-match --filter @aerpp/web run test",
    "check": "node scripts/checks/check-workspace.mjs",
    "check:admin": "pnpm --fail-if-no-match --filter @aerpp/admin run verify",
    "check:config": "pnpm --filter @aerpp/config run check",
    "check:documents": "pnpm --fail-if-no-match --filter @aerpp/documents run check",
    "check:firestore": "pnpm --filter @aerpp/firestore run check",
    "check:support": "pnpm --fail-if-no-match --filter @aerpp/support run verify",
    "check:web": "pnpm --fail-if-no-match --filter @aerpp/web run verify",
    "verify": "pnpm run check && pnpm run test:emulator && git diff --check && pnpm run privacy:check",
    "verify:local": "pnpm run check && pnpm run test:emulator && pnpm run build && pnpm run test:e2e:web && pnpm run test:e2e:admin",
    "verify:publication": "pnpm run verify",
    "verify:release": "node scripts/checks/verify-release.mjs",
    "admin:build-image": "node scripts/admin/build-admin-image.mjs",
    "admin:check-cloud": "node scripts/admin/check-admin-cloud.mjs",
    "admin:check-image": "node scripts/admin/check-admin-image.mjs",
    "admin:prepare-terraform": "node scripts/admin/prepare-admin-deployment.mjs",
    "admin:promote-terraform": "node scripts/admin/promote-admin-terraform.mjs",
    "audit:release": "node scripts/checks/check-release-audit.mjs",
    "auth:login": "node scripts/auth/login-gcloud.mjs",
    "cloud:images": "node scripts/cloud/prune-images.mjs",
    "cloud:inventory": "node scripts/cloud/inventory-google-cloud.mjs",
    "cloud:secrets": "node scripts/cloud/prune-secrets.mjs",
    "contracts:check": "pnpm run lint:contracts && node scripts/contracts/sync-participant-contracts.mjs --check && node scripts/contracts/check-openapi.mjs",
    "contracts:sync": "node scripts/contracts/sync-participant-contracts.mjs",
    "env:check": "node scripts/config/environments.mjs check",
    "env:generate": "node scripts/config/environments.mjs generate",
    "env:init": "node scripts/config/environments.mjs init",
    "env:prepare-secrets": "node scripts/config/prepare-secrets.mjs",
    "env:run": "node scripts/config/run-environment.mjs",
    "env:setup": "node scripts/config/setup-environment.mjs",
    "env:sync": "node scripts/config/sync-environment.mjs",
    "infra:terraform": "node scripts/infra/terraform.mjs",
    "license": "node scripts/licenses/collect-license-notices.mjs && pnpm run license:stage",
    "license:audit": "node scripts/licenses/collect-license-notices.mjs --check --audit",
    "license:check": "node scripts/licenses/collect-license-notices.mjs --check",
    "license:stage": "node scripts/licenses/stage-license-notices.mjs",
    "privacy:check": "node scripts/checks/check-private-config.mjs",
    "private:bundles": "node scripts/maintenance/bundle-retention.mjs",
    "private:images": "node scripts/maintenance/image-retention.mjs",
    "release:check": "node scripts/checks/check-release.mjs",
    "support:build-image": "node scripts/support/build-support-image.mjs",
    "support:check-cloud": "node scripts/support/check-support-cloud.mjs",
    "support:check-data": "node scripts/support/check-support-data.mjs",
    "support:check-gmail": "pnpm --filter @aerpp/support run build && node scripts/support/check-support-gmail.mjs",
    "support:check-image": "node scripts/support/check-support-image.mjs",
    "support:check-mail": "node scripts/support/check-support-mail.mjs",
    "support:check-monitoring": "node scripts/support/check-support-monitoring.mjs",
    "support:check-scheduler": "node scripts/support/check-support-scheduler.mjs",
    "support:emulator:install": "node scripts/support/install-support-emulator.mjs",
    "support:prepare-deployment": "node scripts/support/prepare-support-deployment.mjs",
    "support:select-recovery": "node scripts/support/select-support-recovery.mjs",
    "web:build-image": "node scripts/web/build-web-image.mjs",
    "web:check-image": "node scripts/web/check-web-image.mjs",
    "web:export-bundle": "node scripts/web/export-web-bundle.mjs",
    "web:generate-compose": "node scripts/web/generate-compose.mjs",
    "web:prepare-documents": "node scripts/web/prepare-documents.mjs",
    "web:prepare-questionnaires": "node scripts/web/prepare-questionnaires.mjs"
  },
  "dependencies": {
    "@aerpp/config": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "yaml": "^2.9.1"
  }
}
